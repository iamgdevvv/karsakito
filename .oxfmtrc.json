{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"tabWidth": 4,
	"singleQuote": true,
	"printWidth": 100,
	"singleAttributePerLine": true,
	"sortImports": true,
	"sortTailwindcss": true,
	"ignorePatterns": [
		".agents/**",
		"dist/**",
		"logs/**",
		"node_modules/**",
		".tmp/**",
		"generated/**"
	]
}
