{
	"name": "karyakito-frontend",
	"private": true,
	"type": "module",
	"scripts": {
		"mantine:generate": "npx tailwind-preset-mantine ./app/modules/theme.ts -o ./app/styles/mantine.css",
		"typecheck": "wrangler types && react-router typegen && tsc -b",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "oxlint -c ./.oxlintrc.json --tsconfig ./tsconfig.json --ignore-path ./.eslintignore app",
		"lint:fix": "oxlint -c ./.oxlintrc.json --tsconfig ./tsconfig.json --ignore-path ./.eslintignore --fix app",
		"build": "npm run typecheck && npm run lint && npm run format && react-router build",
		"dev": "react-router dev",
		"deploy": "npm run build && wrangler deploy",
		"preview": "npm run build && vite preview",
		"cf-typegen": "wrangler types",
		"postinstall": "wrangler types"
	},
	"dependencies": {
		"@mantine/carousel": "^9.4.0",
		"@mantine/code-highlight": "^9.4.0",
		"@mantine/core": "^9.4.0",
		"@mantine/dates": "^9.4.0",
		"@mantine/form": "^9.4.0",
		"@mantine/hooks": "^9.4.0",
		"@mantine/notifications": "^9.4.0",
		"@mantine/nprogress": "^9.4.0",
		"@mantine/tiptap": "^9.4.0",
		"@react-router/fs-routes": "^8.0.1",
		"@tiptap/extension-link": "^3.27.1",
		"@tiptap/pm": "^3.27.1",
		"@tiptap/react": "^3.27.1",
		"@tiptap/starter-kit": "^3.27.1",
		"dayjs": "^1.11.21",
		"embla-carousel": "^8.6.0",
		"embla-carousel-react": "^8.6.0",
		"isbot": "^5.1.44",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-router": "8.0.1",
		"tailwind-preset-mantine": "^4.1.0"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.42.3",
		"@react-router/dev": "8.0.1",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^26.0.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"autoprefixer": "^10.5.0",
		"oxfmt": "^0.56.0",
		"oxlint": "^1.71.0",
		"postcss": "^8.5.15",
		"postcss-preset-mantine": "^1.18.0",
		"postcss-simple-vars": "^7.0.1",
		"tailwindcss": "^4.3.1",
		"typescript": "^6.0.3",
		"vite": "^8.1.0",
		"wrangler": "^4.105.0"
	}
}
