{
	"name": "karsakito",
	"private": true,
	"type": "module",
	"scripts": {
		"db:generate": "prisma generate",
		"db:migrate:create": "wrangler d1 migrations create DB",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"db:migrate:remote": "wrangler d1 migrations apply DB --remote",
		"mantine:generate": "npx tailwind-preset-mantine ./app/modules/theme.ts -o ./app/styles/mantine.css",
		"typecheck": "wrangler types && react-router typegen && tsc -b",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "oxlint -c ./.oxlintrc.json --tsconfig ./tsconfig.json --ignore-path ./.eslintignore app",
		"lint:fix": "oxlint -c ./.oxlintrc.json --tsconfig ./tsconfig.json --ignore-path ./.eslintignore --fix app",
		"build": "npm run typecheck && npm run lint && npm run format && react-router build",
		"dev": "react-router dev",
		"deploy": "npm run build && wrangler deploy",
		"preview": "vite preview",
		"cf-typegen": "wrangler types",
		"postinstall": "wrangler types"
	},
	"dependencies": {
		"@mantine/carousel": "^9.4.1",
		"@mantine/code-highlight": "^9.4.1",
		"@mantine/core": "^9.4.1",
		"@mantine/dates": "^9.4.1",
		"@mantine/form": "^9.4.1",
		"@mantine/hooks": "^9.4.1",
		"@mantine/notifications": "^9.4.1",
		"@mantine/nprogress": "^9.4.1",
		"@mantine/spotlight": "^9.4.1",
		"@mantine/tiptap": "^9.4.1",
		"@prisma/adapter-d1": "^7.8.0",
		"@prisma/client": "^7.8.0",
		"@react-router/cloudflare": "^8.1.0",
		"@react-router/fs-routes": "^8.1.0",
		"@tiptap/extension-link": "^3.27.1",
		"@tiptap/pm": "^3.27.1",
		"@tiptap/react": "^3.27.1",
		"@tiptap/starter-kit": "^3.27.1",
		"bcryptjs": "^3.0.3",
		"clsx": "^2.1.1",
		"dayjs": "^1.11.21",
		"dotenv": "^17.4.2",
		"embla-carousel": "^8.6.0",
		"embla-carousel-react": "^8.6.0",
		"isbot": "^5.1.44",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-icons": "^5.6.0",
		"react-router": "8.1.0",
		"tailwind-merge": "^3.6.0",
		"tailwind-preset-mantine": "^4.1.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.42.3",
		"@react-router/dev": "8.1.0",
		"@tailwindcss/postcss": "^4",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^26.0.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"autoprefixer": "^10.5.2",
		"babel-plugin-react-compiler": "^1.0.0",
		"oxfmt": "^0.57.0",
		"oxlint": "^1.72.0",
		"postcss": "^8.5.16",
		"postcss-preset-mantine": "^1.18.0",
		"postcss-simple-vars": "^7.0.1",
		"prisma": "^7.8.0",
		"prisma-zod-generator": "^2.1.4",
		"tailwindcss": "^4.3.2",
		"typescript": "^6.0.3",
		"vite": "^8.1.0",
		"wrangler": "^4.105.0"
	}
}
